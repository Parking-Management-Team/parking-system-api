# Database Connection String (Supabase / PostgreSQL)
DB_CONNECTION_STRING=Host=aws-1-ap-southeast-2.pooler.supabase.com;Database=postgres;Username=postgres;Password=your_password;SSL Mode=Require;Trust Server Certificate=true

# JWT Configuration
JWT_KEY=YourSuperSecretJwtKeyMinimum256BitsLengthForSecurity123!
JWT_ISSUER=PBMS.API
JWT_AUDIENCE=PBMS.Web

# Frontend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:5029
